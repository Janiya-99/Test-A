# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SERVER_ROOT_URI=http://localhost:8000

# SMTP Email Configuration
EMAIL_HOST=your_smtp_host
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_MAILER=smtp
EMAIL_FROM_NAME="Asipbook Flow"

# Authentication & Security
JWT_SECRET=your_jwt_secret
APP_API_KEY=your_app_api_key
PROFILE_API_KEY=your_profile_api_key

# AI / Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Server & Services Linking
PORT=8000
FRONTEND_URL=http://localhost:3000
ACCOUNT_CENTER_API_URL=http://localhost:5000/api
ACCOUNT_CENTER_URL=https://asipiyaaccountcenter.asipbook.com
APPROVAL_ENGINE_URL=http://localhost:5055
WEBHOOK_SECRET=your_webhook_secret
ERP_CALLBACK_URL=http://localhost:8000/api/webhooks/approval-callback
CRM_API_URL=http://localhost:8001

# Database Configuration (MySQL) - According to db/db.js and db/db2.js
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=asipbook_db
DB2_NAME=asipbook_account_center
TEST_DB_NAME=asipiya_test
ACCOUNTCENTER_DB_NAME=asipbook_account_center
